<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android MAUI only. iOS is not a Behavedr SKU (see docs/IOS.md). -->
    <MobileTfms Condition="'$(MobileTfms)' == ''">net10.0-android</MobileTfms>
    <TargetFrameworks>$(MobileTfms)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Behavedr.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ApplicationTitle>Behavedr</ApplicationTitle>
    <ApplicationId>com.croatiasecurity.behavedr</ApplicationId>
    <ApplicationDisplayVersion>0.4.4</ApplicationDisplayVersion>
    <!-- Android versionCode (integer). Must increase for every Play upload. -->
    <ApplicationVersion>44</ApplicationVersion>

    <!-- Publisher APK cert pin (not end users). Optional for release.
         Hex SHA256 of release signing cert, no colons. Comma-separate for Play upload key.
         Use apksigner verify print-certs, then MSBuild property BehavedrAndroidCertSha256
         or env BEHAVEDR_ANDROID_CERT_SHA256 at build time. -->
    <BehavedrAndroidCertSha256 Condition="'$(BehavedrAndroidCertSha256)' == ''">$(BEHAVEDR_ANDROID_CERT_SHA256)</BehavedrAndroidCertSha256>
    <BehavedrAndroidCertSha256 Condition="'$(BehavedrAndroidCertSha256)' == ''"></BehavedrAndroidCertSha256>

    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

    <!-- CA1416: Platform compatibility - we use runtime Build.VERSION.SdkInt checks throughout -->
    <NoWarn Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(NoWarn);CA1416;CA1422</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon only - no splash screen (zero visuals) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B2A4A" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <!-- Play Integrity: opt-in NuGet (EnablePlayIntegrityPackage=true). Reflection path works without it. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(EnablePlayIntegrityPackage)' == 'true'">
    <PackageReference Include="Xamarin.Google.Android.Play.Integrity" Version="1.3.0" />
  </ItemGroup>

  <!-- Android-specific XML resources (network security config, device admin policies) -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidResource Include="Platforms\Android\Resources\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\Resources\xml\device_admin_policies.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Behavedr.Core\Behavedr.Core.csproj" />
  </ItemGroup>

</Project>
